# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# 虚拟环境
.env
.venv
env/
venv/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# Claude 工具配置
.claude/

# Node（曾经用过）
node_modules/

# 输出目录（产出物，不进版本控制）
out/
snapshots/
replicas/
annotations/

# 多序列探索 / 复刻原始产物（敏感医疗数据，绝不提交）
# 生产环境 capture 位于 out/{医院}/runs/{run_id}/capture（已由上方 out/ 覆盖）；
# 这些仓库根级目录仅作防御性覆盖，避免任何未嵌套在 out 下的原始产物被跟踪。
capture/
spy/
/out/**/series_branches/

# 运行时产物（带时间戳）
canvas_frames/*
dicom_meta_*.json
report_*.png
.playwright-mcp/

# 被录制进程持续覆盖的文件，不要纳入版本控制
recorded_script.py

# 调试/运行时日志
debug.log

# 废弃的临时文件
*.tmp.*
*.tmp

# .reasonix：仅跟踪 viewers.yaml 和 skills/，其余（会话状态 JSON、attachments/ 临时剪贴板）忽略
.reasonix/*
!.reasonix/viewers.yaml
!.reasonix/skills/

# Pipeline run storage
out/*/runs/
**/storage_state*.json
**/pipeline_events.jsonl
**/pipeline_report.html
