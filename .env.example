# LLM API 配置
# 复制此文件为 .env 并填入你的 key

# ── 通用 LLM 配置（agent.py 主流程 + vl-config 共享回退） ──
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── VL 专用配置（skills/vl-config/scripts/call_vl.py） ──
# 如果和通用配置是同一个服务，不填也会自动回退到 LLM_* 的值
# VL_API_KEY=
# VL_BASE_URL=
# VL_MODEL=

# ═══════════════════════════════════════════
# 常见非 OpenAI 服务示例（取消注释并替换 key）
# ═══════════════════════════════════════════

# DeepSeek
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 本地 vLLM / Ollama
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-72B

# 阿里云 DashScope
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
